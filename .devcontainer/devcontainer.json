{
  "name": "Fornada",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/fornada",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",

  // Runs on the host: creates .devcontainer/.env with random secrets on the first start.
  "initializeCommand": "bash .devcontainer/init-env.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code"
  ],

  "containerEnv": {
    // Keeps ~/.claude.json (login, trust) inside the persisted volume.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Langfuse", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/fornada/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
