# Dev environment secrets for .devcontainer/compose.yaml: infrastructure
# passwords. Compose builds the agent's DATABASE_URI from FORNADA_DB_PASSWORD.
# These are NOT application settings; those go in the root `.env`.
#
# Copy to `.devcontainer/.env` and fill in, or let the dev container generate
# it with random values (.devcontainer/init-env.sh). Never commit `.env`.

# PostgreSQL superuser
POSTGRES_PASSWORD=

# App database (role and database `fornada`)
FORNADA_DB_PASSWORD=

# Langfuse database (role and database `langfuse`)
LANGFUSE_DB_PASSWORD=

# Langfuse server secrets
LANGFUSE_SALT=
# 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# Langfuse project API keys (created on first start)
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
# Collector -> Langfuse credential: base64 of "PUBLIC_KEY:SECRET_KEY" on one
# line. init-env.sh derives it from the keys above; do not edit it by hand.
LANGFUSE_OTLP_AUTH=

# Langfuse admin login for http://localhost:3000
LANGFUSE_ADMIN_EMAIL=admin@fornada.local
LANGFUSE_ADMIN_PASSWORD=

# Langfuse dependencies
CLICKHOUSE_PASSWORD=
VALKEY_PASSWORD=
MINIO_ROOT_PASSWORD=

# Elasticsearch `elastic` superuser; also the Kibana login at http://localhost:5601
ELASTIC_PASSWORD=
# Built-in `kibana_system` user that Kibana connects as (set by elasticsearch-setup)
KIBANA_SYSTEM_PASSWORD=
# Kibana saved-objects, security and reporting key, at least 32 chars: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=
# `otel_collector` user the Collector writes traces to Elasticsearch as (write-only role, created by elasticsearch-setup)
ELASTIC_OTEL_PASSWORD=
# Salt for the phone hash the Collector writes to Elasticsearch: openssl rand -hex 32
PHONE_HASH_SALT=
