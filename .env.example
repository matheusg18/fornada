# Application settings for Fornada (read by apps/api). Copy to `.env` at the
# repo root and fill in the keys. Dev environment secrets live in
# `.devcontainer/.env`, not here.
#
# Nested settings use a double underscore: NAMESPACE__FIELD.

# --- LLM ---------------------------------------------------------------------
# Active provider: anthropic | openai. Its API key is required.
LLM__PROVIDER=anthropic

LLM__ANTHROPIC__API_KEY=sk-ant-replace-me
LLM__ANTHROPIC__MODEL=claude-haiku-4-5

# Optional while LLM__PROVIDER=anthropic.
LLM__OPENAI__API_KEY=
LLM__OPENAI__MODEL=gpt-5-mini

# Token prices in US$ per million tokens, for the cost metric. Unset, they are
# the default model's published prices (claude-haiku-4-5: 1.00 / 5.00;
# gpt-5-mini: 0.25 / 2.00). Set them when you change the model; the API warns
# at startup if you do not.
# LLM__ANTHROPIC__INPUT_USD_PER_MTOK=1.00
# LLM__ANTHROPIC__OUTPUT_USD_PER_MTOK=5.00
# LLM__OPENAI__INPUT_USD_PER_MTOK=0.25
# LLM__OPENAI__OUTPUT_USD_PER_MTOK=2.00

# --- App ---------------------------------------------------------------------
# IANA time zone used for "now" and calendar dates (lead time, capacity).
APP__TIMEZONE=America/Sao_Paulo
# Oven capacity in kg for dates without a capacity override (holidays etc.).
APP__DAILY_CAPACITY_KG=15

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG__LEVEL=INFO

# --- Database ----------------------------------------------------------------
# PostgreSQL URL for the app data. Inside the dev container, copy the value of
# $DATABASE_URI (role and database `fornada`, host `postgres`).
DB__URL=postgresql://fornada:replace-me@postgres:5432/fornada

# --- Telemetry ---------------------------------------------------------------
# Traces, logs and metrics to the EDOT Collector over OTLP/HTTP. Off unless
# set; on here for the dev container. All three are sent in batches, so they
# reach the Collector a few seconds after the request (metrics every 10 s).
# Each log carries the trace id of the request it was written in. Read by the API and the simulator from this file;
# the chat reads them from its shell or apps/chat/.env (Chainlit loads that one).
TELEMETRY__ENABLED=true
# Base URL of the Collector's OTLP/HTTP receiver (the app adds `/v1/traces`,
# `/v1/logs` and `/v1/metrics`).
TELEMETRY__OTLP_ENDPOINT=http://edot-collector:4318
# Put conversation content (messages, tool arguments and results) and customer
# phones on the agent's spans. Off unless set; on here for the dev container.
# Langfuse gets it in clear; the Collector strips it before Elasticsearch.
TELEMETRY__CAPTURE_CONTENT=true

# --- Chaos mode --------------------------------------------------------------
# Fault injection for simulator runs, in every conversation the API serves:
# random latency on each tool call, `check_capacity` failing at a rate, and the
# price per kg rising after a conversation's first quote. Off unless set; the
# values below are the defaults.
CHAOS__ENABLED=false
# Delay drawn uniformly per tool call, in milliseconds.
CHAOS__LATENCY_MIN_MS=200
CHAOS__LATENCY_MAX_MS=2000
# Probability (0 to 1) that a `check_capacity` call fails.
CHAOS__CAPACITY_FAILURE_RATE=0.1
# Price per kg increase, in percent, after a conversation's first quote.
CHAOS__PRICE_INCREASE_PCT=10
# Integer seed for reproducible draws (needs SIMULATOR__CONCURRENCY=1). Unset:
# a different sequence each start.
# CHAOS__SEED=42

# --- Chat --------------------------------------------------------------------
# Read by apps/chat (Chainlit). Base URL of the API; defaults to the value below.
# Chainlit loads `.env` from the folder it runs in (apps/chat), so set it in the
# shell or in apps/chat/.env when it differs.
# CHAT__API_URL=http://localhost:8000

# --- Simulator ---------------------------------------------------------------
# Read by apps/simulator (the persona simulator). All optional except the key of
# the chosen provider, which must be set in the shell or here.
# SIMULATOR__PROVIDER=anthropic
# SIMULATOR__ANTHROPIC__API_KEY=sk-ant-replace-me
# SIMULATOR__ANTHROPIC__MODEL=claude-haiku-4-5
# SIMULATOR__OPENAI__API_KEY=
# SIMULATOR__OPENAI__MODEL=gpt-5-mini
# SIMULATOR__API_URL=http://localhost:8000
# Customer messages per conversation before it is cut off.
# SIMULATOR__MAX_TURNS=12
# Conversations running at once.
# SIMULATOR__CONCURRENCY=1
# SIMULATOR__RUNS_PER_PERSONA=4
