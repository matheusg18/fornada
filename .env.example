# Application settings for Fornada (read by apps/api). Copy to `.env` at the
# repo root and fill in the keys. Dev environment secrets live in
# `.devcontainer/.env`, not here.
#
# Nested settings use a double underscore: NAMESPACE__FIELD.

# --- LLM ---------------------------------------------------------------------
# Active provider: anthropic | openai. Its API key is required.
LLM__PROVIDER=anthropic

LLM__ANTHROPIC__API_KEY=sk-ant-replace-me
LLM__ANTHROPIC__MODEL=claude-haiku-4-5

# Optional while LLM__PROVIDER=anthropic.
LLM__OPENAI__API_KEY=
LLM__OPENAI__MODEL=gpt-5-mini

# --- App ---------------------------------------------------------------------
# IANA time zone used for "now" and calendar dates (lead time, capacity).
APP__TIMEZONE=America/Sao_Paulo
# Oven capacity in kg for dates without a capacity override (holidays etc.).
APP__DAILY_CAPACITY_KG=15

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG__LEVEL=INFO

# --- Database ----------------------------------------------------------------
# PostgreSQL URL for the app data. Inside the dev container, copy the value of
# $DATABASE_URI (role and database `fornada`, host `postgres`).
DB__URL=postgresql://fornada:replace-me@postgres:5432/fornada

# --- Chat --------------------------------------------------------------------
# Read by apps/chat (Chainlit). Base URL of the API; defaults to the value below.
# Chainlit loads `.env` from the folder it runs in (apps/chat), so set it in the
# shell or in apps/chat/.env when it differs.
# CHAT__API_URL=http://localhost:8000
